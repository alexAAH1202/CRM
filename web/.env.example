# Copy to web/.env.local and fill in from Firebase console > Project settings > Your apps.
# The Firebase web config is public by design, but keep it out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Apps Script web app URL (configuration, not a secret). Set in Phase 7.
VITE_APPS_SCRIPT_URL=

# In `npm run dev` the app uses the local emulators unless this is "false".
VITE_USE_EMULATORS=true

# Show the Firestore read/write meter overlay. Can also be toggled at runtime with
# localStorage.setItem('usageMeter', '1').
VITE_USAGE_METER=false
