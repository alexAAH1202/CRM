{
  "name": "@app/apps-script",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-manifest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
