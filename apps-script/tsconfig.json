{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "None",
    "moduleResolution": "Node10",
    "isolatedModules": false,
    "resolveJsonModule": false,
    "verbatimModuleSyntax": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["google-apps-script"]
  },
  "include": ["src"]
}
