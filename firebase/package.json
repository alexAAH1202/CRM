{
  "name": "@app/firebase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-app --import ./emulator-data --export-on-exit ./emulator-data",
    "test:rules": "firebase emulators:exec --config firebase.test.json --project demo-app --only firestore \"vitest run\"",
    "typecheck": "tsc -p tsconfig.json",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:hosting": "npm --prefix ../web run build && firebase deploy --only hosting"
  },
  "devDependencies": {
    "@app/shared": "^0.0.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.20.5",
    "firebase": "^13.2.0",
    "firebase-tools": "^15.35.0"
  }
}
