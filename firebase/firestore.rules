rules_version = '2';

// Phase 0: deny everything. Phase 1 replaces this with the full role model
// described in docs/DATA_MODEL.md. Every rule added must be covered by tests in
// firebase/tests.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
